{
  "name": "@keymesh/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Public TypeScript SDK for the KeyMesh protocol (prototype maturity).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./wallet": "./src/wallet.ts",
    "./guardian": "./src/guardian.ts",
    "./recovery": "./src/recovery.ts",
    "./transaction": "./src/transaction.ts",
    "./policy": "./src/policy.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@keymesh/protocol": "*",
    "@keymesh/types": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@keymesh/config": "*",
    "@types/node": "^22.10.2",
    "typescript": "5.9.2",
    "vitest": "^2.1.3"
  }
}
